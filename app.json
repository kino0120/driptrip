{
  "expo": {
    "name": "DripTrip",
    "slug": "coffee-log-sns",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kino0120.driptrip",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "コーヒーログの投稿に写真を添付するため（例：飲んだコーヒーやラテアート、訪れたカフェの写真）と、コーヒー豆パッケージをスキャンして産地・焙煎度などを自動入力するために使用します。取得した写真はアプリ内のみで使用し、外部に送信されません。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9fdff02b-e44e-4dac-bcd1-321a77ea014b"
      }
    },
    "owner": "kino0120",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-secure-store"
    ]
  }
}
