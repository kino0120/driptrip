{
  "expo": {
    "name": "DripTrip",
    "slug": "coffee-log-sns",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kino0120.driptrip",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "DripTrip accesses your photo library for two purposes: (1) to attach photos to your coffee log posts — for example, a photo of your latte art or a café interior — and (2) to scan coffee bean package labels using OCR so that details such as origin country, roast level, and flavor notes are filled in automatically. Your photos are used only within the app and are never shared with third parties."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9fdff02b-e44e-4dac-bcd1-321a77ea014b"
      }
    },
    "owner": "kino0120",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-secure-store"
    ]
  }
}
